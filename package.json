{
  "name": "praticon-monorepo",
  "private": true,
  "description": "Praticon: crafted, grid-based SVG icons for web development.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:icons": "tsx scripts/lint-icons.ts",
    "audit:icons": "tsx scripts/audit-icons.ts",
    "optimize": "tsx scripts/optimize.ts",
    "build:components": "tsx scripts/build-components.ts",
    "generate": "pnpm lint:icons && pnpm optimize && pnpm build:components",
    "build": "pnpm generate && pnpm -r build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @praticon-glyphs/site test:e2e",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @praticon-glyphs/svelte --filter @praticon-glyphs/site typecheck",
    "changeset": "changeset",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons": "^3.48.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "feather-icons": "^4.29.2",
    "heroicons": "^2.2.0",
    "jsdom": "^30.1.2",
    "lucide-static": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
