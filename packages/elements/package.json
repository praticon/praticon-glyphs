{
  "name": "@praticon-glyphs/elements",
  "version": "0.3.0",
  "description": "Praticon icons as Web Components that work in any framework or plain HTML. Crafted, grid-based icons for web development.",
  "license": "MIT",
  "author": "kronos456",
  "homepage": "https://praticon.github.io/praticon-glyphs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praticon/praticon-glyphs.git",
    "directory": "packages/elements"
  },
  "bugs": "https://github.com/praticon/praticon-glyphs/issues",
  "keywords": ["icons", "web-components", "custom-elements", "svg", "web-development", "praticon"],
  "type": "module",
  "sideEffects": ["./dist/index.js", "./dist/icons/*.js"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
