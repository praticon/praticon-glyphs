{
  "name": "@praticon-glyphs/react",
  "version": "0.1.0",
  "description": "Praticon icons as tree-shakeable, typed React components. Crafted, grid-based icons for web development.",
  "license": "MIT",
  "author": "kronos456",
  "homepage": "https://praticon.github.io/praticon-glyphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praticon/praticon-glyphs.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/praticon/praticon-glyphs/issues",
  "keywords": ["icons", "react", "svg", "react-icons", "web-development", "praticon"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
